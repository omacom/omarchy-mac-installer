#!/bin/bash
# Stage omarchy-migration into an absolute root. Starts nothing; the units are
# enabled by the vendor .wants links it stages.
set -euo pipefail

destdir=${1:-}
if [[ -z $destdir || $destdir != /* ]]; then
  echo "usage: install DESTDIR  (an absolute path)" >&2
  exit 2
fi
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
base="$destdir/usr/lib/omarchy-migration"
lib="$base/omarchy_migration"
docs="$destdir/usr/share/doc/omarchy-migration"
system="$destdir/usr/lib/systemd/system"
user="$destdir/usr/lib/systemd/user"

install -d -m 0755 "$lib/policies" "$destdir/usr/bin" "$docs" "$destdir/usr/share/licenses/omarchy-migration" \
  "$system/multi-user.target.wants" "$user/graphical-session.target.wants"
install -d -m 0750 "$destdir/etc/sudoers.d"
install -m 0644 "$here"/lib/omarchy_migration/*.py "$lib/"
install -m 0644 "$here"/lib/omarchy_migration/policies/*.json "$lib/policies/"
install -m 0755 "$here/bin/omarchy-migration" "$here/bin/omarchy-migration-import" "$here/bin/omarchy-migration-offer" \
  "$destdir/usr/bin/"
install -m 0755 "$here/libexec/handoff" "$base/handoff"
install -m 0644 "$here/version" "$base/version"
install -m 0644 "$here/systemd/system/omarchy-migration-claim.service" "$system/"
install -m 0644 "$here/systemd/user/omarchy-migration-offer.service" "$user/"
ln -sfn ../omarchy-migration-claim.service "$system/multi-user.target.wants/omarchy-migration-claim.service"
ln -sfn ../omarchy-migration-offer.service "$user/graphical-session.target.wants/omarchy-migration-offer.service"
install -m 0440 "$here/sudoers/omarchy-migration" "$destdir/etc/sudoers.d/omarchy-migration"
install -m 0644 "$here/README.md" "$here"/docs/*.md "$docs/"
install -m 0644 "$here/LICENSE" "$destdir/usr/share/licenses/omarchy-migration/LICENSE"
