# Builds omarchy-migration for a native Omarchy install from this folder.
# The only download is the pinned age it decrypts exports with.
pkgname=omarchy-migration
pkgver=0.2.0
pkgrel=1
pkgdesc="Bring an Omarchy home from Try Omarchy to a native install"
arch=(aarch64)
url="https://github.com/omacom/omarchy-mac-installer"
license=(MIT)
depends=(python sudo)
options=(!strip !debug)
_age_version=1.3.2
_age_sha256=41b072352f4561018949623c674d16ef704019b9108a9bbdbd21292efebfc94f
source=("age-v$_age_version-linux-arm64.tar.gz::https://github.com/FiloSottile/age/releases/download/v$_age_version/age-v$_age_version-linux-arm64.tar.gz")
sha256sums=('6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4')

package() {
  local age="$srcdir/age/age"
  [[ $(sha256sum "$age" | cut -d ' ' -f 1) == "$_age_sha256" ]] || {
    echo "the age binary differs from its pinned digest" >&2
    return 1
  }
  bash "$startdir/install" "$pkgdir"
  install -m 0755 "$age" "$pkgdir/usr/lib/omarchy-migration/age"
  printf '%s  age\n' "$_age_sha256" >"$pkgdir/usr/lib/omarchy-migration/age.sha256"
  chmod 0644 "$pkgdir/usr/lib/omarchy-migration/age.sha256"
}
