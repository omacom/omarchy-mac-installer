            "path": "guest/scripts/materialize-omarchy.sh"
          },
          {
            "block": "\n-- This device carries reconstructed pinch contacts, not physical fingers.\n-- Keep taps and keyboard palm rejection from changing those gestures.\nhl.device({\n  name = \"qemu-virtio-pinch-touchpad\",\n  tap_to_click = false,\n  disable_while_typing = false,\n})\n",
            "commit": "d56a3c0926ab7fd1301a0256df735504124beaa6",
            "path": "guest/native-overlay/usr/share/try-omarchy/pinch-input.lua"
          }
        ],
