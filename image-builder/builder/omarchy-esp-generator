#!/bin/sh
# omarchy-esp-generator: mount /boot/efi and /boot from this Mac's own install.
#
# A systemd generator (systemd.generator(7)), which bin/build-mac-image
# installs at /usr/local/lib/systemd/system-generators/. Every image mounts its
# ESP by the same FAT serial (UUID=4F4D-5801 in fstab) and its Boot partition
# by the same ext4 UUID (BOOT_UUID), so on a Mac with a second Omarchy ESP or
# Boot partition, such as another install or one left by an earlier install
# attempt, Linux can mount the wrong one: boot updates then land where the Mac
# never reads them, and /boot's kernel and initramfs come from the other
# install (omacom/omarchy-mac-installer#219).
#
# The Stage 2 the Mac booted (m1n1, or aura) names the ESP it booted from in
# the device tree, as omarchy-mac-esp reads it. This writes boot-efi.mount for
# that partition into the early generator directory, which takes precedence
# over the unit systemd-fstab-generator makes from fstab. The installer always
# puts the Boot partition right after the ESP (stub, ESP, Boot, Root), so it
# then writes boot.mount for the partition that follows the ESP on the same
# disk, found by start sector through sysfs, but only when that partition's
# ext4 superblock carries the image's Boot UUID. Whatever it can't establish,
# it leaves to fstab, as before.
# Each run (every boot and every daemon-reload) logs one line per mount point
# to the kernel log (journalctl -k), as systemd.generator(7) asks of
# generators, or to stderr where /dev/kmsg isn't writable. Only systemd's
# mounts change: a plain `mount /boot` outside systemd still reads fstab.
#
#   omarchy-esp-generator NORMAL_DIR EARLY_DIR LATE_DIR
#
# Tests run it as a normal user, with OMARCHY_ESP_PARTUUID_FILE naming the
# device-tree property, OMARCHY_SYSFS_BLOCK standing in for /sys/class/block
# and OMARCHY_DEV_DIR for /dev; root always reads the live ones.
set -eu

early=${2:?usage: omarchy-esp-generator NORMAL_DIR EARLY_DIR LATE_DIR}
node=/proc/device-tree/chosen/asahi,efi-system-partition
sys=/sys/class/block
dev=/dev
if [ "$(id -u)" -ne 0 ]; then
  node=${OMARCHY_ESP_PARTUUID_FILE:-$node}
  sys=${OMARCHY_SYSFS_BLOCK:-$sys}
  dev=${OMARCHY_DEV_DIR:-$dev}
fi
# The ext4 UUID every Omarchy image gives its Boot partition (BOOT_UUID in
# bin/build-mac-image), as the 16 bytes of the superblock's s_uuid.
boot_uuid=4f4d5801424f4f548000000000000001

log() {
  if [ -w /dev/kmsg ] && { echo "<5>omarchy-esp-generator: $*" >/dev/kmsg; } 2>/dev/null; then
    :
  else
    echo "omarchy-esp-generator: $*" >&2 || :
  fi
}

# mount_unit NAME WHERE TYPE OPTIONS PARTUUID SOURCE DESCRIPTION: write NAME,
# a mount for /dev/disk/by-partuuid/PARTUUID with fstab's fsck (pass 2), and
# have local-fs.target require it, as systemd-fstab-generator would.
mount_unit() {
  device=/dev/disk/by-partuuid/$5
  fsck=$(/usr/bin/systemd-escape --path "$device")
  mkdir -p "$early/local-fs.target.requires"
  cat >"$early/$1" <<EOF
# Automatically generated by omarchy-esp-generator: $7, in place of fstab's
# UUID that every Omarchy install shares.
[Unit]
Description=$7
Documentation=man:systemd.generator(7)
SourcePath=$6
Before=local-fs.target
Requires=systemd-fsck@$fsck.service
After=systemd-fsck@$fsck.service blockdev@$fsck.target

[Mount]
What=$device
Where=$2
Type=$3
Options=$4
EOF
  ln -sf "../$1" "$early/local-fs.target.requires/$1"
}

# uevent_value FILE KEY: KEY's value in a sysfs uevent file.
uevent_value() {
  sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

# superblock_hex DEVICE OFFSET LENGTH: LENGTH bytes at OFFSET, as hex.
superblock_hex() {
  od -An -v -tx1 -j "$2" -N "$3" "$1" 2>/dev/null | tr -d ' \n' || :
}

# The Boot partition: the one after the ESP (PARTUUID $1) on the same disk.
mount_boot() {
  esp_dir= matches=0
  for d in "$sys"/*; do
    [ "$(uevent_value "$d/uevent" PARTUUID)" = "$1" ] || continue
    esp_dir=$d matches=$((matches + 1))
  done
  if [ "$matches" -ne 1 ]; then
    log "$matches partitions have the ESP's PARTUUID $1; /boot is mounted as fstab says"
    return 0
  fi
  esp_start=$(cat "$esp_dir/start" 2>/dev/null) || esp_start=
  case $esp_start in '' | *[!0-9]*)
    log "no start sector for the ESP; /boot is mounted as fstab says"
    return 0 ;;
  esac
  # The next partition by position on the disk, as the installer lays them
  # out: partition numbers needn't follow position once slots are reused.
  disk=$(cd -P -- "$esp_dir/.." 2>/dev/null && pwd) || disk=
  boot_dir= boot_start=
  if [ -n "$disk" ]; then
    for d in "$disk"/*; do
      [ -f "$d/partition" ] || continue
      start=$(cat "$d/start" 2>/dev/null) || start=
      case $start in '' | *[!0-9]*) continue ;; esac
      if [ "$start" -gt "$esp_start" ] && { [ -z "$boot_dir" ] || [ "$start" -lt "$boot_start" ]; }; then
        boot_dir=$d boot_start=$start
      fi
    done
  fi
  if [ -z "$boot_dir" ]; then
    log "no partition after the ESP on its disk; /boot is mounted as fstab says"
    return 0
  fi
  name=$(uevent_value "$boot_dir/uevent" DEVNAME)
  partuuid=$(uevent_value "$boot_dir/uevent" PARTUUID | tr 'ABCDEF' 'abcdef')
  case $partuuid in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *)
      log "the partition after the ESP has no PARTUUID; /boot is mounted as fstab says"
      return 0 ;;
  esac
  case $name in '' | */* | .*)
    log "the partition after the ESP has no device name; /boot is mounted as fstab says"
    return 0 ;;
  esac
  if [ ! -r "$dev/$name" ]; then
    log "can't read $name, after the ESP; /boot is mounted as fstab says"
    return 0
  fi
  # ext4: s_magic 0xEF53 at 1024+0x38, s_uuid at 1024+0x68.
  if [ "$(superblock_hex "$dev/$name" 1080 2)" != 53ef ] ||
    [ "$(superblock_hex "$dev/$name" 1128 16)" != "$boot_uuid" ]; then
    log "$name, after the ESP, isn't this image's Boot partition; /boot is mounted as fstab says"
    return 0
  fi
  mount_unit boot.mount /boot ext4 defaults,noatime "$partuuid" "$dev/$name" \
    "Boot partition of the install this Mac booted"
  log "mounting /boot from PARTUUID $partuuid ($name), the partition after the ESP"
}

if [ ! -r "$node" ]; then
  log "no ESP named in the device tree; /boot/efi and /boot are mounted as fstab says"
  exit 0
fi
uuid=$(tr -d '\0' <"$node" | tr 'ABCDEF' 'abcdef')
case $uuid in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *)
    log "the device tree's ESP is not one PARTUUID; /boot/efi and /boot are mounted as fstab says"
    exit 0
    ;;
esac

mount_unit boot-efi.mount /boot/efi vfat umask=0077 "$uuid" "$node" \
  "EFI System Partition this Mac booted from"
log "mounting /boot/efi from PARTUUID $uuid, the ESP this Mac booted from"
mount_boot "$uuid"
